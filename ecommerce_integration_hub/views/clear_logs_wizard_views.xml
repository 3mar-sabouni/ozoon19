<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_integration_clear_logs_wizard_form" model="ir.ui.view">
        <field name="name">ecommerce.integration.clear.logs.wizard.form</field>
        <field name="model">ecommerce.integration.clear.logs.wizard</field>
        <field name="arch" type="xml">
            <form string="Clear Sync Transactions">
                <group>
                    <field name="instance_id"/>
                    <field name="scope"/>
                    <field name="confirm"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    This clears connector transaction history only. It does not delete products, categories, orders, stock, or external bindings. Choosing all queue records also removes pending work that has not been sent yet.
                </div>
                <footer>
                    <button name="action_clear" type="object" string="Clear" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
