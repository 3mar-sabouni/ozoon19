<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ecommerce_integration_binding_list" model="ir.ui.view">
        <field name="name">ecommerce.integration.binding.list</field>
        <field name="model">ecommerce.integration.binding</field>
        <field name="arch" type="xml">
            <list decoration-success="sync_state == 'synced'" decoration-danger="sync_state == 'error'">
                <field name="instance_id"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="record_name"/>
                <field name="external_id"/>
                <field name="handle"/>
                <field name="sync_state" widget="badge"/>
                <field name="last_sync_at"/>
                <field name="last_error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ecommerce_integration_binding_form" model="ir.ui.view">
        <field name="name">ecommerce.integration.binding.form</field>
        <field name="model">ecommerce.integration.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="record_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="external_id"/>
                            <field name="handle"/>
                            <field name="sync_state"/>
                            <field name="last_sync_at"/>
                        </group>
                    </group>
                    <field name="last_error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ecommerce_integration_binding" model="ir.actions.act_window">
        <field name="name">Bindings</field>
        <field name="res_model">ecommerce.integration.binding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
