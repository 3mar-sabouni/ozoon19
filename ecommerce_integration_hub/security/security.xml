<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ecommerce_integration" model="ir.module.category">
        <field name="name">Ecommerce Integration Hub</field>
        <field name="description">Access to ecommerce connector instances, queues, bindings and logs.</field>
        <field name="sequence">35</field>
    </record>

    <!-- Odoo 19: groups belong to a res.groups.privilege; the privilege belongs to the module category. -->
    <record id="privilege_ecommerce_connector" model="res.groups.privilege">
        <field name="name">Ecommerce Integration</field>
        <field name="category_id" ref="module_category_ecommerce_integration"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_ecommerce_connector_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_ecommerce_connector"/>
    </record>

    <record id="group_ecommerce_connector_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_ecommerce_connector"/>
        <field name="implied_ids" eval="[(4, ref('group_ecommerce_connector_user'))]"/>
    </record>

    <record id="rule_ecommerce_instance_company" model="ir.rule">
        <field name="name">Ecommerce instances by allowed company</field>
        <field name="model_id" ref="model_ecommerce_integration_instance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_connector_user'))]"/>
    </record>

    <record id="rule_ecommerce_queue_company" model="ir.rule">
        <field name="name">Ecommerce queue by allowed company</field>
        <field name="model_id" ref="model_ecommerce_integration_queue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_connector_user'))]"/>
    </record>

    <record id="rule_ecommerce_log_company" model="ir.rule">
        <field name="name">Ecommerce logs by allowed company</field>
        <field name="model_id" ref="model_ecommerce_integration_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_connector_user'))]"/>
    </record>

    <record id="rule_ecommerce_binding_company" model="ir.rule">
        <field name="name">Ecommerce bindings by allowed company</field>
        <field name="model_id" ref="model_ecommerce_integration_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_connector_user'))]"/>
    </record>

    <record id="rule_ecommerce_locale_company" model="ir.rule">
        <field name="name">Ecommerce locales by allowed company</field>
        <field name="model_id" ref="model_ecommerce_integration_locale"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ecommerce_connector_user'))]"/>
    </record>
</odoo>
