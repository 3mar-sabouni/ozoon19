<?xml version="1.0" encoding="UTF-8"?>
<odoo>

      <!-- ═══════════════════════════════════════════════════
         INCOMING WEBHOOK — Form View
         ═══════════════════════════════════════════════════ -->
      <record id="webhook_incoming_form_view" model="ir.ui.view">
            <field name="name">webhook.incoming.form</field>
            <field name="model">webhook.incoming</field>
            <field name="arch" type="xml">
                  <form string="Incoming Webhook Endpoint">
                        <header>
                              <button name="action_regenerate_key" type="object"
                                    string="🔑 Regenerate Key" class="btn-warning"
                                    confirm="Generate a new API key? The old key will stop working." />
                              <button name="action_copy_url" type="object"
                                    string="📋 Show URL" class="btn-secondary" />
                        </header>
                        <sheet>
                              <div class="oe_button_box" name="button_box">
                                    <button class="oe_stat_button" icon="fa-globe">
                                          <div class="o_stat_info">
                                                <field name="call_count" class="o_stat_value" />
                                                <span class="o_stat_text">Calls</span>
                                          </div>
                                    </button>
                              </div>

                              <div class="oe_title">
                                    <h1>
                                          <field name="name" placeholder="e.g. Shopify Order Sync" />
                                    </h1>
                              </div>

                              <group>
                                    <group string="🔗 Endpoint">
                                          <field name="slug" placeholder="shopify-orders" />
                                          <field name="active" />
                                          <field name="company_id"
                                                groups="base.group_multi_company" />
                                    </group>
                                    <group string="🔒 Authentication">
                                          <field name="auth_mode" widget="radio" />
                                          <field name="api_key" readonly="1"
                                                invisible="auth_mode == 'none'"
                                                widget="CopyClipboardChar" />
                                          <field name="allowed_ips"
                                                placeholder="192.168.1.1, 10.0.0.1" />
                                    </group>
                              </group>

                              <notebook>
                                    <page string="⚡ Action" name="action">
                                          <group>
                                                <field name="action_type" widget="radio" />
                                          </group>

                                          <!-- Create Record -->
                                          <div invisible="action_type != 'create_record'">
                                                <group>
                                                      <field name="target_model_id" />
                                                      <field name="field_mapping"
                                                            widget="ace" options="{'mode': 'json'}"
                                                            placeholder='{"json_field": "odoo_field"}' />
                                                </group>
                                                <div class="alert alert-info">
                                                      <p>Map incoming JSON keys to Odoo field names.
                                                            Example: <code>{"customer_name": "name",
                                                            "customer_email": "email"}</code></p>
                                                </div>
                                          </div>

                                          <!-- Server Action -->
                                          <div invisible="action_type != 'server_action'">
                                                <group>
                                                      <field name="server_action_id" />
                                                </group>
                                                <div class="alert alert-info">
                                                      <p>The incoming payload is available in
                                                            context as <code>
                                                            env.context.get('webhook_payload')</code></p>
                                                </div>
                                          </div>

                                          <!-- Custom Code -->
                                          <div invisible="action_type != 'custom_code'">
                                                <field name="python_code"
                                                      widget="ace" options="{'mode': 'python'}" />
                                                <div class="alert alert-warning">
                                                      <p><strong>Available variables:</strong>
                                    <code>
                                                            payload</code> (dict), <code>env</code>
                                                            (Odoo Environment), <code>log</code>
                                                            (logger). Set <code>result</code> dict
                                                            to return data.</p>
                                                </div>
                                          </div>
                                    </page>

                                    <page string="📊 Info" name="info">
                                          <group>
                                                <field name="log_requests" />
                                                <field name="last_called" readonly="1" />
                                                <field name="call_count" readonly="1" />
                                          </group>
                                    </page>
                              </notebook>
                        </sheet>
                        <chatter />
                  </form>
            </field>
      </record>

      <!-- ═══════════════════════════════════════════════════
         INCOMING WEBHOOK — List View
         ═══════════════════════════════════════════════════ -->
      <record id="webhook_incoming_list_view" model="ir.ui.view">
            <field name="name">webhook.incoming.list</field>
            <field name="model">webhook.incoming</field>
            <field name="arch" type="xml">
                  <list string="Incoming Webhooks"
                        decoration-muted="not active">
                        <field name="name" />
                        <field name="slug" />
                        <field name="auth_mode" />
                        <field name="action_type" />
                        <field name="call_count" />
                        <field name="last_called" />
                        <field name="active" />
                  </list>
            </field>
      </record>

      <!-- ═══════════════════════════════════════════════════
         INCOMING WEBHOOK — Action
         ═══════════════════════════════════════════════════ -->
      <record id="webhook_incoming_action" model="ir.actions.act_window">
            <field name="name">Incoming Webhooks</field>
            <field name="res_model">webhook.incoming</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                  <p class="o_view_nocontent_smiling_face">
                        Create an Incoming Webhook endpoint
                  </p>
                  <p>
                        Allow external systems to push data into Odoo via
                        authenticated HTTP endpoints.
                  </p>
            </field>
      </record>

</odoo>