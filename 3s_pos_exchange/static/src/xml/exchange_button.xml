<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="3s_pos_exchange.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/NoteButton"
               position="after">

            <button class="control-button"
                    t-on-click="onExchangeClick">
                <i class="fa fa-refresh me-1"/>
                Exchange
            </button>

        </xpath>
    </t>

</templates>
