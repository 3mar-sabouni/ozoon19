<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_config_view_form_exchange_days" model="ir.ui.view">
    <field name="name">pos.config.form.exchange.days</field>
    <field name="model">pos.config</field>
    <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
    <field name="arch" type="xml">

        <!-- Insert right after ePos Printer setting -->
        <xpath expr="//setting[@id='other_devices']" position="after">
            <setting
                string="Exchange / Refund Order History"
                help="Limit the number of past days for which paid orders are available for exchange or refund.">

                <field name="exchange_order_days" readonly="has_active_session"/>

                <div class="content-group mt16">
                    <div class="text-muted">
                        Only paid orders from the last <b>X</b> days will be available in the exchange screen.
                    </div>
                </div>
            </setting>
        </xpath>

    </field>
</record>


</odoo>
