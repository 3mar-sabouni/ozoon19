<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="bg_pos_item_counter.OrderDisplay"
       t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class,'order-summary')]" position="inside">
            <div class="total-counts d-flex border-top mt-2 pt-2 text-center align-items-center">
                <div class="flex-fill border-end border-2">
                    <div class="fs-6 text-muted" style="font-size: 0.8rem !important;">Total Items</div>
                    <div class="fw-bolder text-dark">
                        <t t-esc="order.itemCount"/>
                    </div>
                </div>
                <div class="flex-fill">
                    <div class="fs-6 text-muted" style="font-size: 0.8rem !important;">Total Quantity</div>
                    <div class="fw-bolder text-dark">
                        <t t-esc="order.totalQuantity"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>